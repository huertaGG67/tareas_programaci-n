Algoritmo ah
	Escribir 'agrega los numeros a sumar'
	Leer a
	Leer b
	sum=a+b
	Escribir 'el resultado es',sum
	Escribir 'agrega los numeros a restar'
	Leer a
	Leer b
	rest=a-b
	Escribir 'el resultado de la resta es',rest
	Escribir 'agrega los numeros a multiplicar'
	Leer a
	Leer b
	multi=a*b
	Escribir 'el resultado de la multiplicación es',multi
	Escribir 'agrega los numeros a dividir'
	Leer a
	Leer b
	divi=a/b
	Escribir 'el resultado de la division es',divi
FinAlgoritmo
